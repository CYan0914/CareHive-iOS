<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple is the only way into this app, so this entitlement
	     is what makes the first screen work at all. Without it the
	     ASAuthorizationController sheet never appears and a reviewer has no
	     way past the sign-in screen.

	     `Default` is the only meaningful value: it means "Sign in with Apple
	     for this app", as opposed to the alternate key types that are used
	     when one Apple ID serves a primary app and its satellites. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Push. The reminders are what this app is for, so this entitlement is
	     the difference between the product and a logbook.

	     It has to be declared HERE, and that was learned the hard way. The
	     provisioning profile carries aps-environment too, which makes it look
	     like the profile supplies it. It does not: the profile is the ceiling,
	     this file is the request, and what gets signed is the request. A build
	     whose entitlements file omits this signs cleanly, uploads cleanly and
	     passes review, with a signature that has no aps-environment in it at
	     all, and then no push ever arrives. There is no error anywhere, at
	     any point.

	     The value is a build setting rather than a literal because the two
	     environments are not interchangeable: a development-signed build that
	     claims production registers against the production APNs and is
	     refused, and an App Store build that claims development cannot be
	     signed at all. project.yml sets it per configuration. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
